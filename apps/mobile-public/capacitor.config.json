{
  "appId": "link.secret.app",
  "appName": "Secret.link",
  "webDir": "www",
  "appendUserAgent": "SecretlinkApp/1",
  "server": {
    "url": "https://secretlink.life",
    "androidScheme": "https",
    "allowNavigation": ["secretlink.life", "www.secretlink.life"]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0a0a0f"
  },
  "ios": {
    "backgroundColor": "#0a0a0f",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0f",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
