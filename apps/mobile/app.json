{
  "expo": {
    "name": "Secretlink",
    "slug": "secretlink",
    "version": "1.0.0",
    "description": "Encrypted secrets and map drops that disappear. Privacy-first ephemeral messaging.",
    "orientation": "portrait",
    "primaryColor": "#FFFC00",
    "privacy": "public",
    "icon": "./assets/icon.png",
    "scheme": "secretlink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "life.secretlink.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": true
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Secretlink uses the camera to capture photos and videos for encrypted secrets.",
        "NSPhotoLibraryUsageDescription": "Secretlink needs access to your photo library to attach images to secrets.",
        "NSLocationWhenInUseUsageDescription": "Secretlink uses your location to show nearby secrets on the map.",
        "NSFaceIDUsageDescription": "Secretlink uses Face ID to secure your account.",
        "ITSAppUsesNonExemptEncryption": true,
        "ITSEncryptionExportComplianceCode": ""
      },
      "associatedDomains": [
        "applinks:secretlink.life",
        "webcredentials:secretlink.life"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFC00"
      },
      "package": "life.secretlink.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "secretlink.life",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "secretlink"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-system-ui",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFC00",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Secretlink uses your location to show nearby secrets on the map."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Secretlink needs access to your photos to attach images to secrets.",
          "cameraPermission": "Secretlink uses the camera to capture photos and videos for encrypted secrets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://secretlink.life"
      },
      "eas": {
        "projectId": "b99ce94d-0800-4632-b340-1d42a0691af5"
      }
    },
    "owner": "waactech"
  }
}
