    "@koa/router": "^13.1.0",
    "@koa/cors": "^5.0.0",
    "koa-bodyparser": "^4.4.0",
    "koa-helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "undici": "^7.27.0",
    "zod": "^3.24.0",
    "neverthrow": "^8.0.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@secretlink/config-tsconfig": "workspace:*",
    "@secretlink/config-eslint": "workspace:*",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa-bodyparser": "^4.3.0",
