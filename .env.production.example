# ─── Secretlink production environment ───────────────────────────────────────
# Copy this file to `.env` ON THE SERVER ONLY. Never commit the real `.env`.
# Generate fresh secret values with: node scripts/gen-secrets.mjs
#
# In AWS, the deploy script can instead materialise this file from SSM
# Parameter Store (see scripts/pull-ssm-env.sh). Prefer SSM in production.

# ── Auth / crypto (REQUIRED) ─────────────────────────────────────────────────
# 32+ byte random hex. Rotating these logs out every existing session.
JWT_SECRET=
SESSION_SECRET=
# 32-byte base64 key used to wrap secret DEKs and encrypt IVS stream keys at rest.
MASTER_KEY=

# ── Web Push (REQUIRED) — generate with: npx web-push generate-vapid-keys ─────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:waac.world@gmail.com

# ── WebAuthn / CORS ──────────────────────────────────────────────────────────
RP_ID=secretlink.life
RP_ORIGIN=https://secretlink.life,https://admin.secretlink.life
CORS_ORIGINS=https://secretlink.life,https://admin.secretlink.life

# ── AWS ──────────────────────────────────────────────────────────────────────
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY UNSET in production: the EC2
# instance profile role supplies credentials automatically. Only set them for
# local development against real AWS services.
AWS_REGION=eu-north-1
SES_REGION=eu-north-1
SES_FROM=hello@secretlink.life
IVS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Blob storage ─────────────────────────────────────────────────────────────
# local = on-disk .blobs (dev only). s3 = durable object storage (prod).
STORAGE_DRIVER=s3
BLOB_BUCKET=secretlink-blobs-455155948605

# ── Misc ─────────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
DB_PATH=./data/secretlink.db
LOG_LEVEL=info
