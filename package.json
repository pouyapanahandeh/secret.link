{
  "name": "secretlink",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/react-native-reanimated/android/CMakeLists.txt';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace(/ -Werror/g,'');fs.writeFileSync(p,c)}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "undici@>=6.0.0 <6.27.0": "6.27.0",
      "undici@>=5.0.0 <5.29.0": "5.29.0",
      "esbuild@<=0.24.2": "0.25.0",
      "tar@<=7.5.15": "7.5.16",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
      "postcss@<8.5.10": "8.5.10",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "js-yaml@>=4.0.0 <=4.1.1": "4.2.0",
      "uuid@>=11.0.0 <11.1.1": "11.1.1",
      "smol-toml@<1.6.1": "1.6.1",
      "estree-util-value-to-estree@<3.3.3": "3.3.3",
      "vite@<=6.4.2": "6.4.3",
      "drizzle-orm@<0.45.2": "0.45.2"
    }
  }
}
